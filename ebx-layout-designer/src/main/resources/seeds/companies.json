{
 "format": "ebx-form-layout/1",
 "name": "Companies – Sociétés (rev 4.2)",
 "model": "urn:ebx:module:EBX FastTrack - TIBCO EBX Presales environment:/WEB-INF/ebx/schemas/Companies.xsd",
 "table": "/root/Companies",
 "locales": [
  "en-US",
  "fr-FR",
  "it-IT"
 ],
 "tabs": [
  {
   "label": {
    "en-US": "Overview",
    "fr-FR": "Vue d'ensemble",
    "it-IT": "Panoramica"
   },
   "count": [],
   "rows": [
    {
     "columns": 1,
     "blocks": [
      [
       {
        "type": "hero",
        "title": "/Identification/Name",
        "sub": [
         "/LegalInformation/legalName",
         "/LegalInformation/legalForm",
         "/Address/City"
        ],
        "chips": [
         "/AdditionalInformation/ActivitySector",
         "/Address/Country",
         "/Lifecycle/status",
         "/LegalInformation/isin"
        ],
        "meter": "/Governance/completenessScore",
        "status": "/EInvoicing/readiness",
        "id": "b1"
       }
      ]
     ]
    },
    {
     "columns": 1,
     "blocks": [
      [
       {
        "type": "facts",
        "items": [
         "/LegalInformation/registrationNumber",
         "/AdditionalInformation/naceCode",
         "/LegalInformation/employeesCount",
         "/LegalInformation/annualRevenue",
         "/LegalInformation/incorporationDate"
        ],
        "count": "/directSubsidiaries",
        "id": "b2"
       }
      ]
     ]
    },
    {
     "columns": 1,
     "blocks": [
      [
       {
        "type": "validation",
        "title": {
         "en-US": "To review",
         "fr-FR": "À traiter",
         "it-IT": "Da verificare"
        },
        "sev": {
         "error": true,
         "warning": true,
         "info": true
        },
        "group": "severity",
        "max": 5,
        "links": true,
        "hideEmpty": false,
        "actions": [
         {
          "on": "/EInvoicing",
          "btn": {
           "en-US": "Add an address",
           "fr-FR": "Ajouter une adresse",
           "it-IT": "Aggiungi un indirizzo"
          },
          "go": "/eInvoicingAddresses"
         }
        ],
        "id": "b3"
       }
      ]
     ]
    },
