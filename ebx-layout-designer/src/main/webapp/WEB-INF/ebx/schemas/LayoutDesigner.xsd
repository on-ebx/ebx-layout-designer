<?xml version='1.0' encoding='UTF-8'?>
<!--LayoutDesigner: data model of the ebx-layout-designer module. One row of FormLayout per (data model, table):
    the layout drawn in the designer, as JSON, read at each display by com.on.ebx.layout.runtime.ConfigurableForm.
    UserFormPreference: one user's own arrangement of a form, laid over that layout.
    ExplorerLayout (1.16.0): explorers, search pages over a table; ExplorerFavorite: the records a user starred in one.-->
<xs:schema xmlns:osd="urn:ebx-schemas:common_1.0" xmlns:fmt="urn:ebx-schemas:format_1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:import namespace="urn:ebx-schemas:common_1.0" schemaLocation="http://schema.orchestranetworks.com/common_1.0.xsd"/>
    <xs:annotation>
        <xs:appinfo>
            <osd:inheritance>
                <dataSetInheritance>none</dataSetInheritance>
            </osd:inheritance>
        </xs:appinfo>
    </xs:annotation>
    <xs:element name="root" osd:access="--">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="FormLayout" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Form layouts</osd:label>
                            <osd:description>One record form layout per table of a data model, drawn in the Layout Designer and read at each display of a record.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Mises en page de fiches</osd:label>
                            <osd:description>Une mise en page de fiche par table d'un modèle de données, dessinée dans le Layout Designer et lue à chaque affichage d'un enregistrement.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="it-IT">
                            <osd:label>Layout delle schede</osd:label>
                            <osd:description>Un layout di scheda per tabella di un modello di dati, disegnato nel Layout Designer e letto a ogni visualizzazione di un record.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./label}</defaultLabel>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Id</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Identifiant</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Identificativo</osd:label></xs:documentation>
                                    <xs:appinfo>
                                        <osd:autoIncrement/>
                                    </xs:appinfo>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:int"/>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="label" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Label</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Libellé</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Etichetta</osd:label></xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="model" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Data model</osd:label><osd:description>Schema location, as SchemaLocation.format() writes it (urn:ebx:module:… or urn:ebx:publication:…).</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Modèle de données</osd:label><osd:description>Emplacement du modèle, tel que l'écrit SchemaLocation.format() (urn:ebx:module:… ou urn:ebx:publication:…).</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Modello di dati</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="1000"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="table" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Table</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Table</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Tabella</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="500"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="active" type="xs:boolean" minOccurs="1" maxOccurs="1" default="true">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Active</osd:label><osd:description>When false, the standard EBX form is shown.</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Active</osd:label><osd:description>Quand faux, la fiche standard d'EBX s'affiche.</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Attivo</osd:label></xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="layout" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Layout (JSON)</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Mise en page (JSON)</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Layout (JSON)</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text"/>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="version" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Version</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Version</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Versione</osd:label></xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="previousForm" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Previous record form</osd:label><osd:description>The recordForm class the model declared before the designer's one; put back on deactivation.</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Fiche précédente</osd:label><osd:description>La classe recordForm que le modèle déclarait avant celle du designer ; remise en place à la désactivation.</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Scheda precedente</osd:label></xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="updatedBy" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Updated by</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Modifié par</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Modificato da</osd:label></xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="updatedOn" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Updated on</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Modifié le</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Modificato il</osd:label></xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="UserFormPreference" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Personal form arrangements</osd:label>
                            <osd:description>How a user arranged a form for themself (tab order, blocks hidden, folded or pinned), laid over the layout drawn in the designer. One row per user, data model, table and variant.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Fiches personnalisées</osd:label>
                            <osd:description>Comment un utilisateur a organisé une fiche pour lui-même (ordre des onglets, blocs masqués, repliés ou épinglés), posé sur la mise en page dessinée dans le designer. Une ligne par utilisateur, modèle, table et variante.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="it-IT">
                            <osd:label>Schede personalizzate</osd:label>
                            <osd:description>Come un utente ha organizzato una scheda per sé (ordine delle schede, blocchi nascosti, chiusi o fissati). Una riga per utente, modello, tabella e variante.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/user /model /table /variant </primaryKeys>
                                <defaultLabel>${./user} · ${./table}</defaultLabel>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="user" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>User</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Utilisateur</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Utente</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="200"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="model" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Data model</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Modèle de données</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Modello di dati</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="1000"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="table" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Table</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Table</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Tabella</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="500"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="variant" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Variant</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Variante</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Variante</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="100"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="prefs" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Arrangement (JSON)</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Organisation (JSON)</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Organizzazione (JSON)</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text"></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="updatedOn" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Updated on</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Modifié le</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Modificato il</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:dateTime"></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="ExplorerLayout" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Explorers</osd:label>
                            <osd:description>Search pages over a table (facets, tiles, cards), drawn in the Layout Designer and read at each opening of the Explorer service. Several explorers may target the same table.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Explorateurs</osd:label>
                            <osd:description>Pages de recherche sur une table (facettes, tuiles, cartes), dessinées dans le Layout Designer et lues à chaque ouverture du service Explorateur. Plusieurs explorateurs peuvent viser la même table.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="it-IT">
                            <osd:label>Esploratori</osd:label>
                            <osd:description>Pagine di ricerca su una tabella (facette, riquadri, schede), disegnate nel Layout Designer.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./label}</defaultLabel>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Id</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Identifiant</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Identificativo</osd:label></xs:documentation>
                                    <xs:appinfo>
                                        <osd:autoIncrement/>
                                    </xs:appinfo>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:int"/>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="label" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Label</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Libellé</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Etichetta</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="200"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="model" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Data model</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Modèle de données</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Modello di dati</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="1000"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="table" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Table</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Table</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Tabella</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="500"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="active" type="xs:boolean" minOccurs="1" maxOccurs="1" default="true">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Active</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Actif</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Attivo</osd:label></xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="layout" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Explorer (JSON)</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Explorateur (JSON)</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Esploratore (JSON)</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text"/>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="version" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Version</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Version</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Versione</osd:label></xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="updatedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Updated by</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Modifié par</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Modificato da</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="200"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="updatedOn" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Updated on</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Modifié le</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Modificato il</osd:label></xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="ExplorerFavorite" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Explorer favorites</osd:label>
                            <osd:description>The records a user starred in an explorer. One row per user, explorer, dataspace, dataset and record.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Favoris des explorateurs</osd:label>
                            <osd:description>Les fiches qu'un utilisateur a mises en favori dans un explorateur. Une ligne par utilisateur, explorateur, espace de données, jeu de données et fiche.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="it-IT">
                            <osd:label>Preferiti degli esploratori</osd:label>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/user /explorer /dataspace /dataset /record </primaryKeys>
                                <defaultLabel>${./user} · ${./record}</defaultLabel>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="user" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>User</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Utilisateur</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Utente</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="200"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="explorer" type="xs:int" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Explorer</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Explorateur</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Esploratore</osd:label></xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="dataspace" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Dataspace</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Espace de données</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Spazio dati</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="200"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="dataset" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Dataset</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Jeu de données</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Set di dati</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="200"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="record" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Record key</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Clé de la fiche</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Chiave del record</osd:label></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string"><xs:maxLength value="500"/></xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="addedOn" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Added on</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Ajouté le</osd:label></xs:documentation>
                                    <xs:documentation xml:lang="it-IT"><osd:label>Aggiunto il</osd:label></xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
